<UserControl x:Class="MedicalCard1.Controls.EditAppointmentControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MedicalCard1.Controls"
             mc:Ignorable="d" d:DesignWidth="300" Background="White" d:DesignHeight="650">
    <Grid Margin="10">
        <StackPanel Orientation="Vertical">
            <TextBlock Text="Редактирование записи" TextWrapping="Wrap" FontWeight="Bold" FontSize="20" Foreground="DarkBlue"/>
            <Separator Margin="0 2 0 10"/>

            <TextBlock Text="Дата визита:" Margin="5" FontWeight="Bold"/>
            <DatePicker SelectedDate="{Binding VisitData}" />

            <TextBlock Text="Жалобы:" Margin="5" FontWeight="Bold"/>
            <TextBox Text="{Binding Complaints}" Height="60" AcceptsReturn="True"/>

            <TextBlock Text="Анамнез:" Margin="5" FontWeight="Bold"/>
            <TextBox Text="{Binding Anamnesis}" Height="60" AcceptsReturn="True"/>

            <TextBlock Text="Диагноз:" Margin="5" FontWeight="Bold"/>
            <TextBox Text="{Binding Diagnosis}" Height="60" AcceptsReturn="True"/>

            <TextBlock Text="Назначение врача:" Margin="5" FontWeight="Bold"/>
            <TextBox Text="{Binding DoctorsOrder}" Height="60" AcceptsReturn="True"/>

            <Button Content="Сохранить" Width="120" Height="25" Margin="0 10 0 0" Click="SaveButton_Click"/>
            <Button Content="Отмена" Width="120" Height="25" Margin="0 5 0 0" Click="CancelButton_Click"
                    Background="White"
                    Foreground="DarkBlue"/>
        </StackPanel>
    </Grid>
</UserControl>
