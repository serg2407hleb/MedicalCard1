<UserControl x:Class="MedicalCard1.Controls.ViewAppointmentControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MedicalCard1.Controls"
             mc:Ignorable="d" d:DesignWidth="300" Background="White" d:DesignHeight="650">
    <Grid Margin="10">
        <StackPanel Orientation="Vertical">
            <TextBlock Text="Запись Доктора" TextWrapping="Wrap" FontWeight="Bold" FontSize="20" Foreground="DarkBlue"/>
            <Separator Margin="0 2 0 10"/>

            <TextBlock Text="ФИО пациента:" Margin="5" FontWeight="Bold"/>
            <TextBlock Text="{Binding Patient.FullName}" FontSize="16"/>

            <TextBlock Text="ФИО врача:" Margin="5" FontWeight="Bold"/>
            <TextBlock Text="{Binding Doctor.FullName}" FontSize="16"/>

            <TextBlock Text="Дата приёма:" Margin="5" FontWeight="Bold"/>
            <TextBlock Text="{Binding VisitData, StringFormat='dd/MM/yyyy'}" FontSize="16"/>

            <TextBlock Text="Жалобы:" Margin="5" FontWeight="Bold"/>
            <TextBlock Text="{Binding Complaints}" FontSize="16"
                       ScrollViewer.VerticalScrollBarVisibility="Auto"
                       TextWrapping="Wrap"/>

            <TextBlock Text="Анамнез:" Margin="5" FontWeight="Bold"/>
            <TextBlock Text="{Binding Anamnesis}" FontSize="16"
                       ScrollViewer.VerticalScrollBarVisibility="Auto"
                       TextWrapping="Wrap"/>

            <TextBlock Text="Диагноз:" Margin="5" FontWeight="Bold"/>
            <TextBlock Text="{Binding Diagnosis}" FontSize="16"
                       ScrollViewer.VerticalScrollBarVisibility="Auto"
                       TextWrapping="Wrap"/>

            <TextBlock Text="Назначение врача:" Margin="5" FontWeight="Bold"/>
            <TextBlock Text="{Binding DoctorsOrder}" FontSize="16"
                       ScrollViewer.VerticalScrollBarVisibility="Auto"
                       TextWrapping="Wrap"/>

            <Button Content="Удалить" Width="120" Height="25" Margin="0 10 5 0" Click="DeleteButton_Click"/>
            <Button Content="Редактировать" Width="120" Height="25" Margin="0 5 0 0" Click="EditButton_Click"/>
            <Button Content="Закрыть" Width="120" Height="25" Margin="0 10 0 0" Click="CloseButton_Click"
                    Background="White"
                    Foreground="DarkBlue"/>
        </StackPanel>
    </Grid>
</UserControl>
