<UserControl x:Class="MedicalCard1.Controls.AddUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MedicalCard1.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="300" Background="White">
    <Grid x:Name="RootGrid" Margin="10">
        <StackPanel Orientation="Vertical">
            <TextBlock Text="Регистрация пользователя" TextWrapping="Wrap" FontWeight="Bold" FontSize="20" Foreground="DarkBlue"/>
            <Separator Margin="0 10 0 10"/>

            <TextBlock Text="Имя" FontSize="16" FontWeight="Bold"/>
            <TextBox x:Name="NameTextBox" Width="200" Height="30" FontSize="16" Padding="2"/>

            <TextBlock Text="Фамилия" FontSize="16" FontWeight="Bold"/>
            <TextBox x:Name="LastNameTextBox" Width="200" Height="30" FontSize="16" Padding="2"/>

            <TextBlock Text="Логин" FontSize="16" FontWeight="Bold"/>
            <TextBox x:Name="LoginTextBox" Width="200" Height="30" FontSize="16" Padding="2"/>

            <TextBlock Text="Пароль" FontSize="16" FontWeight="Bold"/>
            <PasswordBox x:Name="PasswordBox" Width="200" Height="30" FontSize="16" Padding="2"/>

            <TextBlock Text="Роль" FontSize="16" FontWeight="Bold"/>
            <ComboBox x:Name="RolesComboBox" Width="200" Height="30" FontSize="16" Padding="2"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 10 0 0">
                <Button Content="Сохранить" Width="100" Height="25" Margin="5" Click="SaveButton_Click"/>
                <Button Content="Отмена" Width="100" Height="25" Margin="5" Click="CancelButton_Click"
                        Background="White"
                        Foreground="DarkBlue"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
