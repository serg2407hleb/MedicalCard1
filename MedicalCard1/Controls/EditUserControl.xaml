<UserControl x:Class="MedicalCard1.Controls.EditUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MedicalCard1.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="300"
             Background="White">
    <Grid Margin="10">
        <StackPanel Orientation="Vertical">
            <TextBlock Text="Редактирование профиля" TextWrapping="Wrap" FontWeight="Bold" FontSize="20" Foreground="DarkBlue"/>
            <Separator Margin="0 10 0 10"/>

            <TextBlock Text="Имя:" FontWeight="Bold"/>
            <TextBox x:Name="NameTextBox" FontSize="16" Height="30"/>

            <TextBlock Text="Фамилия:" FontWeight="Bold"/>
            <TextBox x:Name="LastNameTextBox" FontSize="16" Height="30"/>

            <TextBlock Text="Логин:" FontWeight="Bold"/>
            <TextBox x:Name="LoginTextBox" FontSize="16" Height="30"/>

            <TextBlock Text="Пароль:" FontWeight="Bold"/>
            <PasswordBox x:Name="PasswordBox" FontSize="16" Height="30"/>

            <TextBlock Text="Роль:" FontWeight="Bold"/>
            <ComboBox x:Name="RolesComboBox" Width="200" Height="30" FontSize="16"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 10 0 0">
                <Button Content="Сохранить" Width="100" Height="25" Margin="5" Click="SaveButton_Click"/>
                <Button Content="Отмена" Width="100" Height="25" Margin="5" Click="CancelButton_Click"
                        Background="White"
                        Foreground="DarkBlue"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
