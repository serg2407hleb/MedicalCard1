<UserControl x:Class="MedicalCard1.Controls.AddPatientControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MedicalCard1.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="300" Background="White">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Регистрация пациента" TextWrapping="Wrap" FontWeight="Bold" FontSize="20" Foreground="DarkBlue"  Grid.Row="0"/>
        <Separator Grid.Row="1"/>

        <TextBlock Text="Имя:" FontWeight="Bold" Grid.Row="2" Margin="5"/>
        <TextBox x:Name="FirstNameTextBox" Grid.Row="3" Height="20"/>

        <TextBlock Text="Фамилия:" FontWeight="Bold" Grid.Row="4" Margin="5"/>
        <TextBox x:Name="LastNameTextBox" Grid.Row="5" Height="20"/>

        <TextBlock Text="Номер паспорта:" FontWeight="Bold" Grid.Row="6" Margin="5"/>
        <TextBox x:Name="PassportNumberTextBox" Grid.Row="7" Height="20"/>

        <TextBlock Text="Дата рождения:" FontWeight="Bold" Grid.Row="8" Margin="5"/>
        <DatePicker x:Name="BirthDatePicker" Grid.Row="9" Height="30"/>

        <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Сохранить" Click="SaveButton_Click" Margin="5 10 5 0" Width="70" Height="25"/>
            <Button Content="Отмена" Click="CancelButton_Click" Margin="5 10 5 0" Width="70" Height="25"
                    Background="White"
                    Foreground="DarkBlue"/>
        </StackPanel>
    </Grid>
</UserControl>
