<UserControl x:Class="MedicalCard1.Controls.PatientInfoControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MedicalCard1.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="300" Background="White">
    <Grid Margin="10">
        <StackPanel Orientation="Vertical">
            <TextBlock Text="Профиль пациента" TextWrapping="Wrap" FontWeight="Bold" FontSize="20" Foreground="DarkBlue"/>
            <Separator Margin="0 2 0 10"/>

            <TextBlock Text="ФИО:" Margin="5" FontWeight="Bold"/>
            <TextBlock Text="{Binding FullName}" FontSize="16"/>

            <TextBlock Text="Паспорт:" Margin="5" FontWeight="Bold"/>
            <TextBlock Text="{Binding Passport}" FontSize="16"/>

            <TextBlock Text="Дата рождения:" Margin="5" FontWeight="Bold"/>
            <TextBlock Text="{Binding Birth, StringFormat='dd/MM/yyyy'}" FontSize="16"/>

            <TextBlock Text="Возраст:" Margin="5" FontWeight="Bold"/>
            <TextBlock Text="{Binding Age}" FontSize="16"/>

            <Button Content="Закрыть" Width="120" Height="25" Margin="0 10 0 0" Click="CloseButton_Click"
                    Background="White"
                    Foreground="DarkBlue"/>
            <Button Content="Удалить" Width="120" Height="25" Margin="0 5 0 0" Click="DeleteButton_Click"/>
            <Button Content="Редактировать" Width="120" Height="25" Margin="0 5 0 0" Click="EditButton_Click"/>
            <Button Content="Новая запись" Width="120" Height="25" Margin="0 5 0 0"
                    Background="White"
                    Foreground="DarkBlue"
                    Click="CreateNewAppointment_Click"/>
        </StackPanel>
        <StackPanel>
</StackPanel>
    </Grid>
</UserControl>
