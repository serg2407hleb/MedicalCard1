<Window x:Class="MedicalCard1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MedicalCard1"
        mc:Ignorable="d"
        Title="Medical Cart" Height="720" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="AliceBlue"
        MinWidth="800"
        MinHeight="600">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="1" Grid.Column="0"
                   Orientation="Vertical"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   MaxWidth="320" MaxHeight="270">

            <TextBlock Text="Вход" FontSize="32" Margin="0 0 0 0"
                       Foreground="Blue"
                       FontWeight="Bold"
                       FontFamily="Segoe Print"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Авторизуйтесь в системе" FontSize="16" Margin="0 0 0 3"
                       Foreground="DimGray"
                       FontFamily="Ebrima"
                       HorizontalAlignment="Center"/>

            <Label Content="Логин:" FontSize="16" FontFamily="Franklin Gothic Medium"
                   Margin="5 0 0 0"/>
            <TextBox x:Name="LoginBox" Width="300" Height="30"
                     FontSize="16"
                     Padding="2"
                     Margin="0 0 0 5"
                     Background="MintCream"
                     BorderBrush="DarkSlateBlue"
                     BorderThickness="1"/>

            <Label Content="Пароль:" FontSize="16" FontFamily="Franklin Gothic Medium"
                   Margin="5 0 0 0"/>
            <PasswordBox x:Name="PasswordBox" Width="300" Height="30"
                         FontSize="16"
                         Padding="2"
                         Margin="0 0 0 5"
                         Background="MintCream"
                         BorderBrush="DarkSlateBlue"
                         BorderThickness="1"/>

            <Button Content="Войти" Width="300"
                    Margin="0 15 0 5"
                    Click="OnLoginClick"
                    FontSize="20"/>
        </StackPanel>
    </Grid>
</Window>
