<Window x:Class="MedicalCard1.Windows.SuperAdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MedicalCard1.Windows"
        mc:Ignorable="d"
        Title="Medical Cart: SuperAdmin" Height="720" Width="1280"
        MinWidth="800" MinHeight="600" SizeToContent="Manual"
        Background="AliceBlue"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <DockPanel Grid.Row="0" Background="MintCream" Height="40">
            <TextBlock DockPanel.Dock="Left" Text="Супер-администратор: default" VerticalAlignment="Center"
                       Margin="5,0,0,0"
                       FontFamily="Franklin Gothic Medium"
                       FontSize="20"
                       Foreground="DarkBlue"/>
            <Button DockPanel.Dock="Right" Content="Выход" Click="Logout_Click"
                    Width="70"
                    Height="25"
                    HorizontalAlignment="Right"
                    Margin="0 0 5 0"
                    FontSize="11"/>
        </DockPanel>

        <!-- Панель с названиями колонок -->
        <Grid Grid.Row="1" Background="LightSkyBlue" Height="25">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Меню" HorizontalAlignment="Center" FontWeight="Bold" FontSize="16" Foreground="DarkBlue"/>
            <TextBlock Grid.Column="1" Text="Пользователи" HorizontalAlignment="Center" FontWeight="Bold" FontSize="16" Foreground="DarkBlue"/>
            <TextBlock Grid.Column="2" Text="Подробности" HorizontalAlignment="Center" FontWeight="Bold" FontSize="16" Foreground="DarkBlue"/>
        </Grid>

        <!-- Основная область -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <!-- Три равные колонки -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая панель -->
            <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1" Padding="10">
                <StackPanel>
                    <Button x:Name="DoctorsBut" Content="Врачи"
                            Margin="5 5 5 5"
                            FontSize="15"/>
                    <Button x:Name="AdminsBut" Content="Администраторы"
                            Margin="5 5 5 5"
                            FontSize="15"/>
                    <Button x:Name="NewUserBut" Content="Новый пользователь"
                            Margin="5 5 5 5"
                            FontSize="15"/>
                </StackPanel>
            </Border>

            <!-- Центральная панель -->
            <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="1" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ListView Style="{StaticResource CustomListViewStyle}" x:Name="UsersListView" ItemsSource="{Binding}" IsSynchronizedWithCurrentItem="True" MouseDoubleClick="UsersListView_MouseDoubleClick">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn DisplayMemberBinding="{Binding FullName}" Width="200"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </ScrollViewer>
            </Border>

            <!-- Правая панель -->
            <Border Grid.Column="2" BorderBrush="Gray" BorderThickness="1" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ContentPresenter x:Name="RightPanelContent"/>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
