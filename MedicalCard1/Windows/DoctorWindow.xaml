<Window x:Class="MedicalCard1.Windows.DoctorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MedicalCard1.Windows"
        mc:Ignorable="d"
        Title="Medical Cart: Doctor" Height="720" Width="1280"
        MinWidth="800" MinHeight="600" SizeToContent="Manual"
        Background="AliceBlue"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <DockPanel Grid.Row="0" Background="MintCream" Height="40">
            <TextBlock DockPanel.Dock="Left" Text="Врач: " VerticalAlignment="Center"
               Margin="5,0,0,0"
               FontFamily="Franklin Gothic Medium"
               FontSize="20"
               Foreground="DarkBlue"/>
            <TextBlock DockPanel.Dock="Left" Text="{Binding FullName}"
       VerticalAlignment="Center"
       Margin="5,0,0,0"
       FontFamily="Franklin Gothic Medium"
       FontSize="20"
       Foreground="DarkBlue"/>
            <Button DockPanel.Dock="Right" Content="Выход" Click="Logout_Click"
            Width="70"
            Height="25"
            HorizontalAlignment="Right"
            Margin="0 0 5 0"
            FontSize="11"/>
        </DockPanel>

        <!-- Панель с названиями колонок -->
        <Grid Grid.Row="1" Background="LightSkyBlue" Height="25">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Пациенты" HorizontalAlignment="Center" FontWeight="Bold" FontSize="16" Foreground="DarkBlue"/>
            <TextBlock Grid.Column="1" Text="Записи" HorizontalAlignment="Center" FontWeight="Bold" FontSize="16" Foreground="DarkBlue"/>
            <TextBlock Grid.Column="2" Text="Подробности" HorizontalAlignment="Center" FontWeight="Bold" FontSize="16" Foreground="DarkBlue"/>
        </Grid>

        <!-- Три вертикальные панели -->
        <Grid Grid.Row="2" Margin="0,10,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая панель -->
            <Border BorderBrush="Gray" BorderThickness="1" Padding="10" Grid.Column="0">
                <ListView x:Name="PatientListView" SelectionChanged="PatientListView_SelectionChanged"
                          Style="{StaticResource CustomListViewStyle}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="{Binding FullName}" FontSize="16"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <!-- Центральная панель -->
            <Border BorderBrush="Gray" BorderThickness="1" Padding="10" Grid.Column="1">
                <ListView x:Name="VisitListView"
                          Style="{StaticResource CustomListViewStyle}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn DisplayMemberBinding="{Binding VisitData, StringFormat='dd/MM/yyyy'}"/>
                            <GridViewColumn DisplayMemberBinding="{Binding Doctor.FullName}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>

            <!-- Правая панель -->
            <Border BorderBrush="Gray" BorderThickness="1" Padding="10" Grid.Column="2">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ContentPresenter x:Name="RightDocPanelContent"/>
                </ScrollViewer>
            </Border>

        </Grid>

        <Grid Grid.Row="3" Background="MintCream" Height="30" Margin="0 10 0 0">
            <StackPanel VerticalAlignment="Center">
                <Button Content="Регистрация пациента" Width="310"
                        HorizontalAlignment="Left"
                        FontSize="15"
                        Background="White"
                        Foreground="BLack"
                        Click="OpenAddPatientForm_Click"/>
            </StackPanel>
        </Grid>

    </Grid>
</Window>
